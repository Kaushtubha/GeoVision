# ==============================================================================
# GeoVision: Environment Configuration Template
# ==============================================================================

# Hardware Acceleration: "cuda" or "cpu"
GEOVISION_DEVICE=cpu

# API Server Configuration
GEOVISION_HOST=127.0.0.1
GEOVISION_PORT=8000
GEOVISION_RELOAD=false
GEOVISION_WORKERS=1

# MLflow Experiment Tracking Server (optional)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=GeoVision-Default

# Qdrant Vector Search Engine (optional; in-memory fallback enabled by default)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=geovision_scenes
QDRANT_API_KEY=

# LLM / Grounded VLM Provider (optional; for external LLM augmentation)
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_TOKEN=

# Frontend API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000
